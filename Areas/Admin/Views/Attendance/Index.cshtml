@model List<AttendanceViewModel>
@using Microsoft.AspNetCore.Mvc.Rendering
@using payroll_mvc.Areas.Employee.ViewModels
@using payroll_mvc.ViewModels

@{
    var startDate = Context.Request.Query["startDate"].ToString();
    var endDate = Context.Request.Query["endDate"].ToString();

    if (string.IsNullOrEmpty(startDate))
    {
        startDate = DateTime.Today.ToString("yyyy-MM-dd");
    }
    if (string.IsNullOrEmpty(endDate))
    {
        endDate = DateTime.Today.ToString("yyyy-MM-dd");
    }

    var statusOptions = ViewData["StatusOptions"] as List<StatusViewModel>;
}

<div class="container mt-2">
    <div class="row align-items-end g-3 mb-3">

        <!-- Date Range + Button -->
        <div class="col-lg-6">
            <form asp-action="Index" method="get">
                <div class="row g-2 align-items-end">

                    <div class="col-md-4">
                        <label class="form-label fw-bold small">Start Date</label>
                        <input type="date" name="startDate" value="@startDate" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-bold small">End Date</label>
                        <input type="date" name="endDate" value="@endDate" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Button -->
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">Fetch Status</button>
                    </div>

                </div>
            </form>
        </div>

        <!-- Search -->
        <div class="col-lg-6">
            <label class="form-label fw-bold small">Search</label>

            <div class="input-group">
                <input type="text" id="searchInput" class="form-control" placeholder="Search employee..." />
                <button type="button" onclick="clearSearch()" class="btn btn-outline-secondary">Clear</button>
            </div>
        </div>

    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-secondary p-2 d-flex justify-content-center">
            <h5 class="text-dark">No Attendance Data Found</h5>
        </div>
    }

    else
    {
        <form method="post" asp-action="UpdateAttendance">
            <input type="hidden" name="startDate" value="@startDate" />
            <input type="hidden" name="endDate" value="@endDate" />

            <div class="overflow-auto" style="max-height:60vh;">
                <table class="table table-bordered table-striped" id="attendanceTable">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Employee Code</th>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Actions</th>
                            <th>Comment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td>@Model[i]?.Date?.ToString("dd-MM-yyyy")</td>
                                <td>@Model[i]?.EmpCode</td>
                                <td>@Model[i]?.Name</td>
                                <td>
                                    @{
                                        var status = Model[i]?.Status ?? "Absent";
                                        var badgeClass = status switch
                                        {
                                            "Present" => "bg-success text-white",
                                            "Absent" => "bg-danger text-white",
                                            "Leave" => "bg-warning text-white",
                                            _ => "bg-secondary"
                                        };
                                    }

                                    <span class="badge @badgeClass">
                                        @status
                                    </span>
                                </td>
                                <td>
                                    <select name="[@i].Status" class="form-select form-select-sm">

                                        @if (statusOptions != null && statusOptions.Any())
                                        {
                                            foreach (var option in statusOptions)
                                            {
                                                <option value="@option.StatusName"
                                                        selected="@(option.StatusName == status)">
                                                    @option.StatusName
                                                </option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="">No status available</option>
                                        }

                                    </select>
                                    <input type="hidden" name="[@i].EmployeeId" value="@Model[i].EmployeeId" />
                                    <input type="hidden" name="[@i].Date" value="@Model[i]?.Date?.ToString("yyyy-MM-ddTHH:mm:ss")" />
                                </td>
                                <td>
                                    <input type="text" name="[@i].Note" value="@Model[i]?.Note" class="form-control form-control-sm" placeholder="Add comment" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <button type="submit" class="btn btn-success px-4">Update</button>
            </div>
        </form>
    }
</div>

<script>
    document.getElementById("searchInput").addEventListener("keyup", function () {
        let filter = this.value.toLowerCase();
        let rows = document.querySelectorAll("#attendanceTable tbody tr");

        rows.forEach(row => {
            let empCode = row.cells[1].innerText.toLowerCase();
            let name = row.cells[2].innerText.toLowerCase();

            if (empCode.includes(filter) || name.includes(filter)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    });

    function clearSearch() {
        document.getElementById("searchInput").value = "";
        let rows = document.querySelectorAll("#attendanceTable tbody tr");
        rows.forEach(row => {
            row.style.display = "";
        });
    }
</script>
