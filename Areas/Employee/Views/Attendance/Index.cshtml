@model List<AttendanceViewModel>

@{
    var startDate = Context.Request.Query["startDate"].ToString();
    var endDate = Context.Request.Query["endDate"].ToString();

    if (string.IsNullOrEmpty(startDate))
    {
        startDate = DateTime.Today.ToString("yyyy-MM-dd");
    }
    if (string.IsNullOrEmpty(endDate))
    {
        endDate = DateTime.Today.ToString("yyyy-MM-dd");
    }
    var employee = Model.FirstOrDefault();
}

<div class="container mt-2">
    <div class="row align-items-end g-3 mb-3">

        <!-- Date Range + Button -->
        <div class="col-lg-12">
            <form asp-action="Index" method="get">
                <div class="row g-2 align-items-end">

                    <div class="col-md-5">
                        <label class="form-label fw-bold small">Start Date</label>
                        <input type="date" name="startDate" value="@startDate" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-5">
                        <label class="form-label fw-bold small">End Date</label>
                        <input type="date" name="endDate" value="@endDate" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Button -->
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Fetch Status</button>
                    </div>

                </div>
            </form>
        </div>

    </div>

    @if (Model.Count == 0)
    {
        <div class="bg-secondary p-2 d-flex justify-content-center">
            <h5 class="text-dark">No Attendance Data Found</h5>
        </div>
    }

    else
    {
        <div class="overflow-auto" style="max-height:60vh;">
            <table class="table table-bordered table-striped" id="attendanceTable">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Employee Code</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>@Model[i]?.Date?.ToString("dd-MM-yyyy")</td>
                            <td>@Model[i]?.EmpCode</td>
                            <td>@Model[i]?.Name</td>
                            <td>
                                @{
                                    var status = Model[i]?.Status ?? "Absent";
                                    var badgeClass = status switch
                                    {
                                        "Present" => "bg-success text-white",
                                        "Absent" => "bg-danger text-white",
                                        "Leave" => "bg-warning text-white",
                                        _ => "bg-secondary"
                                    };
                                }

                                <span class="badge @badgeClass">
                                    @status
                                </span>
                            </td>
                            <td>
                                @if (Model[i]?.Status == "Present")
                                {
                                    <span class="btn btn-sm btn-secondary w-100 disabled">
                                        Marked
                                    </span>
                                }
                                else if (Model[i]?.Date?.Date < DateTime.Today)
                                {
                                    <span class="btn btn-sm btn-secondary w-100 disabled">
                                        N/A
                                    </span>
                                }
                                else
                                {
                                    <a asp-area="Employee" asp-action="FaceAttendance"
                                       asp-controller="Attendance"
                                       asp-route-id="@Model[i].EmployeeId"
                                       asp-route-date="@Model[i]?.Date?.ToString("yyyy-MM-dd")"
                                       class="btn btn-sm btn-warning w-100">
                                        Scan Face
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

