        rows.forEach(row => {
            let empCode = row.cells[1].innerText.toLowerCase();
            let name = row.cells[2].innerText.toLowerCase();

            if (empCode.includes(filter) || name.includes(filter)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
